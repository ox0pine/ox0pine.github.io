@import '_hljs-github';
@import '_variables';

.body {
  line-height: 2em;
  padding-left: 50px;
  padding-right: 50px;
}

.post-inner {
  margin: 0 auto;
  max-width: 900px;

  .video-container {
    height: 0;
    margin-bottom: 20px;
    overflow: hidden;
    padding-top: 75%;
    position: relative;
    width: 100%;

    iframe {
      height: 100%;
      left: 0;
      margin: 0;
      position: absolute;
      top: 0;
      width: 100%;
    }
  }
}

/* Article + sticky table of contents as a two column grid.
   The old implementation floated the TOC and pulled it back with a negative
   margin, which overflowed between 760px and 1023px wide viewports. */
.post-inner--toc {
  max-width: 1030px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 200px;
  column-gap: 30px;
  align-items: start;

  .post-content__head,
  .post-content__body {
    grid-column: 1;
  }

  .toc-outer {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
}

.post-content {
  padding: 10px 0;
  margin: 0 auto;
}

.post-gallery {
  align-items: center;
  display: grid;
  grid-gap: 10px;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 20px;
}

.post-title {
  font-size: 30px;
  font-weight: bold;
  line-height: 1.45;
  margin: 0;
}

.post-content__head {
  margin: 40px 0;
}

.post-content__head .post-excerpt {
  color: $black-lighter;
  font-size: $font-size-small;
  line-height: 1.8em;

  p {
    margin: 0;
  }
}

.toc-outer {
  position: sticky;
  top: 20px;
  max-height: calc(100vh - 40px);
  padding-left: 10px;
  overflow-y: auto;
  color: $black-lighter;
  font-size: $font-size-small;

  .toc-title, .toc-top {
    display: inline-block;
    padding: 8px 0;
    color: $text-color;
    font-size: $font-size-small;
    height: 30px;
    line-height: 30px;
  }

  .toc-title {
    border-top: 2px solid $white-blue;
  }

  a {
    text-decoration: none;
  }

  ol, li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-number {
    font-size: 80%;
  }

  .post-toc {
    width: 100%;
    text-align: left;
    margin: 0;
    padding: 0;
    display: inline-block;
    box-sizing: border-box;
    line-height: 1.25em;

    &-level {
      &-2 {
        font-size: 15px;
        margin: 5px 0;
      }

      &-3 {
        font-size: 14px;
        padding-left: 10px;
      }
    }
  }
}

.post__foot {
  max-width: 900px;
  margin: 100px auto;
}

.post-nav {
  position: relative;
  margin-top: 60px;
  display: flex;
  width: 100%;
  justify-content: space-between;

  .vhr {
    position: absolute;
    height: 50px;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    margin: auto;
    background-color: $whitesmoke;
    width: 1px;
  }
}

.post-nav-item {
  text-decoration: none;
  flex: 1;
  display: flex;
  flex-direction: column;

  &-left {
    @extend .post-nav-item;
    align-items: flex-start;
    padding-right: 15px;
  }

  &-right {
    @extend .post-nav-item;
    align-items: flex-end;
    padding-left: 15px;
  }
}

.related-post {
  margin: 40px 0;
}

@media screen and (max-width: 1023px) {
  .body {
    padding-left: 30px;
    padding-right: 30px;
  }

  .post-gallery {
    grid-template-columns: repeat(2, 1fr);
  }

  .post-inner--toc {
    display: block;
    max-width: 900px;

    .toc-outer {
      display: none;
    }
  }
}
