@import '_hljs-github';
@import '_variables';

.body {
  line-height: 2em;
  padding-left: 50px;
  padding-right: 50px;
}

.post-inner {
  margin: 0 auto;
  max-width: 900px;

  .video-container {
    height: 0;
    margin-bottom: 20px;
    overflow: hidden;
    padding-top: 75%;
    position: relative;
    width: 100%;

    iframe {
      height: 100%;
      left: 0;
      margin: 0;
      position: absolute;
      top: 0;
      width: 100%;
    }
  }
}

/* Article + sticky table of contents as a two column grid.
   The old implementation floated the TOC and pulled it back with a negative
   margin, which overflowed between 760px and 1023px wide viewports. */
.post-inner--toc {
  max-width: 1200px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  column-gap: 64px;
  align-items: start;

  .post-content__head,
  .post-content__body {
    grid-column: 1;
  }

  .toc-outer {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
}

.post-content {
  padding: 10px 0;
  margin: 0 auto;
}

/* Article prose justifies; the rest of the site stays left-aligned so Latin
   words in UI text do not open gaps between characters. */
.post-content__body p {
  text-align: justify;
}

/* Justifying text in a 330px column opens gaps around every Latin word. */
@media screen and (max-width: 760px) {
  .post-content__body p {
    text-align: left;
  }
}

/* The phone header is fixed over the page, so in-page anchors need clearance
   between the bar and the heading they land on. */
@media screen and (max-width: 1023px) {
  .post-content__body :is(h2, h3, h4, h5) {
    scroll-margin-top: 76px;
  }
}

.post-gallery {
  align-items: center;
  display: grid;
  grid-gap: 10px;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 20px;
}

.post-title {
  font-size: 34px;
  font-weight: bold;
  line-height: 1.4;
  margin: 0;
}

.post-content__head {
  margin: 48px 0 40px;
  padding-bottom: 28px;
  border-bottom: 1px solid $grey-lighter;
}

/* The excerpt reads as a standfirst: one step larger than body copy and
   lighter than the title. */
.post-content__head .post-excerpt {
  color: $black-light;
  font-size: 17px;
  line-height: 1.9em;
  margin-top: 18px;

  p {
    margin: 0;
  }
}

/* Sticky table of contents, centred against the viewport: `top: 50vh` pins
   its top edge to the middle of the screen and the transform lifts it by half
   its own height, so it stays optically centred while the article scrolls
   (viewports units are used rather than `50%` because percentages resolve
   against the grid area in some engines). */
.toc-outer {
  position: sticky;
  top: 50vh;
  top: 50dvh;
  transform: translateY(-50%);
  /* Capped so the centred box can never ride up under the 90px header on the
     first screen; longer outlines scroll inside the column. */
  max-height: calc(100vh - 200px);
  max-height: calc(100dvh - 200px);
  overflow-y: auto;
  padding-right: 4px;
  border-left: 1px solid $gainsboro;
  /* Nested levels keep a #666 floor: #999 on white is 2.8:1, which fails
     WCAG AA at these sizes. Depth is carried by indent and size instead. */
  color: $black-light;
  font-size: 15px;
  scrollbar-width: thin;

  .toc-title {
    display: block;
    margin: 0;
    padding: 6px 0 12px 16px;
    color: $black-lighter;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.18em;
    line-height: 1;
  }

  ol, li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-toc-link {
    display: block;
    margin-left: -1px;
    padding: 6px 10px 6px 15px;
    border-left: 2px solid transparent;
    color: inherit;
    line-height: 1.6;
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease;

    &:hover {
      color: $black-deep;
      border-left-color: $grey-light;
    }
  }

  .post-toc-level-3 .post-toc-link {
    margin-left: 15px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 14px;
    color: $black-lighter;
    font-size: 14px;
    line-height: 1.5;
  }

  .post-toc-level-4 .post-toc-link {
    margin-left: 30px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 14px;
    color: $black-lighter;
    font-size: 13px;
    line-height: 1.5;
  }

  .post-toc-link.is-active {
    border-left-color: $blue-link;
    color: $blue-link;
  }

  .toc-top {
    display: inline-block;
    margin-top: 16px;
    padding: 4px 0 4px 15px;
    color: $grey-dark;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 150ms ease;

    &:hover {
      color: $blue-link;
    }
  }
}

.post__foot {
  max-width: 900px;
  margin: 100px auto;
}

/* Keep the prev/next row aligned with the article column when the sticky TOC
   owns the right 332px of a 1200px shell. */
.post__foot--toc {
  max-width: 1200px;
  padding-right: 364px;
  box-sizing: border-box;
}

.post-nav {
  position: relative;
  margin-top: 60px;
  display: flex;
  width: 100%;
  justify-content: space-between;

  .vhr {
    position: absolute;
    top: 6px;
    right: 0;
    left: 0;
    bottom: 6px;
    margin: auto;
    background-color: $gainsboro;
    width: 1px;
  }
}

.post-nav-item {
  text-decoration: none;
  flex: 1;
  display: flex;
  flex-direction: column;
  color: $black-light;
  transition: color 150ms ease;

  &-left {
    @extend .post-nav-item;
    align-items: flex-start;
    padding-right: 15px;
  }

  &-right {
    @extend .post-nav-item;
    align-items: flex-end;
    padding-left: 15px;
  }
}

@media (hover: hover) and (pointer: fine) {
  .post-nav-item-left:hover,
  .post-nav-item-right:hover {
    color: $blue-link;
  }
}

/* Direction label: small, muted, with the chevron doing the pointing so the
   two sides read as "back" and "forward" without relying on a font glyph. */
.post-nav-label {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: $grey-dark;
  font-size: 12px;
  letter-spacing: 0.1em;
  transition: color 150ms ease;
}

.post-nav-icon {
  display: block;
  transition: transform 150ms ease;
}

.post-nav-item-left:hover .post-nav-icon {
  transform: translateX(-2px);
}

.post-nav-item-right:hover .post-nav-icon {
  transform: translateX(2px);
}

.post-nav-title {
  margin-top: 6px;
  font-size: 15px;
  line-height: 1.6;
}

@media screen and (max-width: 1023px) {
  .body {
    padding-left: 30px;
    padding-right: 30px;
  }

  .post-gallery {
    grid-template-columns: repeat(2, 1fr);
  }

  .post-inner--toc {
    display: block;
    max-width: 900px;

    .toc-outer {
      display: none;
    }
  }

  .post__foot--toc {
    padding-right: 0;
  }
}

/* Tablet-landscape widths keep the TOC but give the article its room back. */
@media screen and (max-width: 1199px) and (min-width: 1024px) {
  .post-inner--toc {
    grid-template-columns: minmax(0, 1fr) 230px;
    column-gap: 40px;
  }

  .post__foot--toc {
    padding-right: 270px;
  }
}
