@import '_hljs-github';
@import '_variables';

.body {
  line-height: 2em;
  padding-left: 50px;
  padding-right: 50px;
}

.post-inner {
  margin: 0 auto;
  max-width: 900px;

  .video-container {
    height: 0;
    margin-bottom: 20px;
    overflow: hidden;
    padding-top: 75%;
    position: relative;
    width: 100%;

    iframe {
      height: 100%;
      left: 0;
      margin: 0;
      position: absolute;
      top: 0;
      width: 100%;
    }
  }
}

/* Article + sticky table of contents as a two column grid.
   The old implementation floated the TOC and pulled it back with a negative
   margin, which overflowed between 760px and 1023px wide viewports. */
.post-inner--toc {
  max-width: 1030px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220px;
  column-gap: 32px;
  align-items: start;

  .post-content__head,
  .post-content__body {
    grid-column: 1;
  }

  .toc-outer {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
}

.post-content {
  padding: 10px 0;
  margin: 0 auto;
}

.post-gallery {
  align-items: center;
  display: grid;
  grid-gap: 10px;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 20px;
}

.post-title {
  font-size: 30px;
  font-weight: bold;
  line-height: 1.45;
  margin: 0;
}

.post-content__head {
  margin: 40px 0;
}

.post-content__head .post-excerpt {
  color: $black-lighter;
  font-size: $font-size-small;
  line-height: 1.8em;

  p {
    margin: 0;
  }
}

/* Sticky table of contents. A hairline rail carries the current-section
   marker so the list stays monochrome and a single accent colour is enough.
   Rail + text colour both change on the active entry, so the state survives
   greyscale rendering. */
.toc-outer {
  position: sticky;
  top: 32px;
  max-height: calc(100vh - 64px);
  overflow-y: auto;
  padding-right: 4px;
  border-left: 1px solid $gainsboro;
  color: $black-extra-lighter;
  font-size: 13px;
  scrollbar-width: thin;

  .toc-title {
    display: block;
    margin: 0;
    padding: 6px 0 10px 14px;
    color: $grey-dark;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 0.22em;
    line-height: 1;
  }

  ol, li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-toc-link {
    display: block;
    margin-left: -1px;
    padding: 5px 10px 5px 13px;
    border-left: 2px solid transparent;
    color: inherit;
    line-height: 1.55;
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease;

    &:hover {
      color: $black-deep;
      border-left-color: $grey-light;
    }
  }

  .post-toc-level-3 .post-toc-link {
    margin-left: 13px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 12px;
    color: $grey-dark;
    font-size: 12px;
    line-height: 1.45;
  }

  .post-toc-level-4 .post-toc-link {
    margin-left: 26px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 12px;
    color: $grey;
    font-size: 12px;
    line-height: 1.45;
  }

  .post-toc-link.is-active {
    border-left-color: $blue-link;
    color: $blue-link;
  }

  .toc-top {
    display: inline-block;
    margin-top: 14px;
    padding: 4px 0 4px 13px;
    color: $grey-dark;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 150ms ease;

    &:hover {
      color: $blue-link;
    }
  }
}

.post__foot {
  max-width: 900px;
  margin: 100px auto;
}

.post-nav {
  position: relative;
  margin-top: 60px;
  display: flex;
  width: 100%;
  justify-content: space-between;

  .vhr {
    position: absolute;
    top: 6px;
    right: 0;
    left: 0;
    bottom: 6px;
    margin: auto;
    background-color: $gainsboro;
    width: 1px;
  }
}

.post-nav-item {
  text-decoration: none;
  flex: 1;
  display: flex;
  flex-direction: column;
  color: $black-light;
  transition: color 150ms ease;

  &-left {
    @extend .post-nav-item;
    align-items: flex-start;
    padding-right: 15px;
  }

  &-right {
    @extend .post-nav-item;
    align-items: flex-end;
    padding-left: 15px;
  }
}

@media (hover: hover) and (pointer: fine) {
  .post-nav-item-left:hover,
  .post-nav-item-right:hover {
    color: $blue-link;
  }
}

/* Direction label: small, muted, with the chevron doing the pointing so the
   two sides read as "back" and "forward" without relying on a font glyph. */
.post-nav-label {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: $grey-dark;
  font-size: 12px;
  letter-spacing: 0.1em;
  transition: color 150ms ease;
}

.post-nav-icon {
  display: block;
  transition: transform 150ms ease;
}

.post-nav-item-left:hover .post-nav-icon {
  transform: translateX(-2px);
}

.post-nav-item-right:hover .post-nav-icon {
  transform: translateX(2px);
}

.post-nav-title {
  margin-top: 6px;
  font-size: 15px;
  line-height: 1.6;
}

@media screen and (max-width: 1023px) {
  .body {
    padding-left: 30px;
    padding-right: 30px;
  }

  .post-gallery {
    grid-template-columns: repeat(2, 1fr);
  }

  .post-inner--toc {
    display: block;
    max-width: 900px;

    .toc-outer {
      display: none;
    }
  }
}
