$white-blue-lightest = #fcfcfb;
$white-blue = #eff2f3;
$whitesmoke-light = #f9f9f9;
$whitesmoke = #f5f5f5;
$gainsboro = #eee;
$grey-lighter = #ddd;
$grey-light = #ccc;
$grey = #bbb;
$grey-dark = #999;
$black = #000;
$black-light = #555;
$black-lighter = #666;
$black-extra-lighter = #888;
$black-dim = #333;
$black-deep = #222;
$blue-link = #143c74;
$text-color = $black-light;
$link-color = $black-light;
$link-hover-color = $black-deep;
$font-size-base = 18px;
$font-size-smallest = 0.75em;
$font-size-smaller = 0.8125em;
$font-size-small = 0.875em;
$font-size-medium = 1em;
$font-size-large = 1.125em;
$font-size-larger = 1.25em;
$font-size-largest = 1.5em;
$font-size-title = 2.5em;
/* The web font is a per-build subset of LXGW WenKai (~850 KB per weight), and
   with `font-display: optional` a slow first visit renders the fallback
   instead of swapping mid-read. The fallback is therefore a kai face first —
   Kaiti SC / KaiTi ship with macOS, iOS and Windows — so that first paint is
   already in the same hand as WenKai. Songti and friends only catch glyphs
   that no kai face covers. */
$font-family-serif = LXGWWenKai, "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", "Noto Serif CJK SC", "SimSun", serif;
$font-family-base = $font-family-serif;
$max-width = 1200px;
$content-width = 900px;
/* Custom easing curves. The built-in ease-* keywords are too weak to read as
   intentional at UI durations: entering an element uses $ease-out so it
   answers the pointer immediately, in-place movement uses $ease-in-out so the
   element accelerates and settles instead of starting slow. */
$ease-out = cubic-bezier(0.23, 1, 0.32, 1);
$ease-in-out = cubic-bezier(0.77, 0, 0.175, 1);
