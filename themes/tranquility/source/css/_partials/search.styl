/* Search trigger: a compact pill that is always readable, instead of a box
   whose width grows on hover. The old version animated `width` + a
   translate on hover, which reflowed the whole nav row on every pointer
   pass; hover now only tints the pill. */
.search-outer {
  font-weight: normal;
  color: $black-lighter;
  cursor: pointer;
  display: flex;
  align-items: center;
  height: 34px;
  padding: 0 10px;
  border-radius: 999px;
  transition: background-color 150ms ease, color 150ms ease, transform 140ms $ease-out;

  +desktop() {
    margin-right: 26px;
  }

  @media (hover: hover) and (pointer: fine) {
    &:hover {
      background-color: $whitesmoke;
      color: $black-deep;
    }
  }

  &:active {
    transform: scale(0.96);
  }
}

#search-btn {
  display: none;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}

/* The icon alone carries the trigger on phones; the label and shortcut hint
   would push the nav apart at 390px. */
@media screen and (max-width: 1023px) {
  .search-outer {
    position: absolute;
    top: 50%;
    right: 12px;
    margin: 0;
    padding: 0 8px;
    transform: translateY(-50%);
  }

  .search-outer:active {
    transform: translateY(-50%) scale(0.94);
  }

  #search-btn .search-label,
  #search-btn .search-shortcut-key {
    display: none;
  }
}

.search__head {
  padding: 0 20px 10px;
}

.search-shortcut-key {
  display: flex;
  padding: 2px 4px;
  margin: 0 5px;
  border: 1px solid $black-lighter;
  border-radius: 5px;
  font-size: $font-size-smallest;
}

#search-main {
  position: absolute;
  margin: 60px auto 0;
  width: 500px;
  left: 0;
  right: 0;
  font-size: $font-size-base;
  background: #fff;
  border-radius: 8px;
  padding: 20px 0;
  box-shadow: 0 14px 44px rgba(0, 0, 0, 0.14);
  opacity: 1;
  transition: opacity 160ms ease, transform 200ms $ease-out;

  /* Closed state lives here rather than in @starting-style so the same
     transition covers both directions. */
  #search-mask:not(.is-open) & {
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
  }

  +mobile-tablet() {
    margin: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
  }
}

.search-form {
  display: flex;
  width: 100%;
  align-items: center;
  border: 1px solid #555;
  border-radius: 3px;
  transition: border-color 150ms ease;

  &:focus-within {
    border-color: $blue-link;
  }

  & .icon {
    padding: 8px;
  }
}

#search-clear {
  cursor: pointer;
}

#search-input {
  font-size: $font-size-base;
  outline: none;
  flex: 1;
  border: none;
  height: 2em;
  padding: 4px;
  background: transparent;

  &::-webkit-search-cancel-button,
  &::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }
}

.search__body {
  max-height: calc(80vh - 120px);
  overflow: hidden auto;

  +mobile-tablet() {
    max-height: calc(100% - 80px);
    padding-bottom: 10px;
  }
}

.search-result-item {
  display: block;
  padding: 10px 20px;
  text-decoration: none;
  border-bottom: 1px solid $white-blue;
}

.search-result__head {
  font-size: $font-size-smaller;
  color: $blue-link;
  margin: 8px 0;
}

.search-result__body {
  font-size: $font-size-small;
}

.search-keyword {
  color: inherit;
  background: rgba(255, 208, 0, 0.32);
  border-radius: 2px;
}

/* The dialog is opened from the keyboard as often as from the pill, so it
   fades and nudges instead of snapping in. `visibility` (not `display`)
   carries the closed state: it removes the panel from the tab order and can
   be delayed on exit, while `display` transitions are unreliable here. */
#search-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(232, 232, 232, 0.78);
  opacity: 0;
  visibility: hidden;
  transition: opacity 160ms ease, visibility 0s linear 160ms;
}

#search-mask.is-open {
  opacity: 1;
  visibility: visible;
  transition: opacity 160ms ease;
}

.search-result-empty {
  text-align: center;
  padding: 10px 0;
}