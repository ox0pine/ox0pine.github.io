@import '_variables';

html {
  font-family: $font-family-base;
  font-size: $font-size-base;
  color: $text-color;
  text-align: justify;
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

html, body {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

a {
  color: $link-color;
}

a:hover {
  color: $link-hover-color;
}

:focus-visible {
  outline: 2px solid $blue-link;
  outline-offset: 2px;
}

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  z-index: 200;
  padding: 10px 16px;
  background: #fff;
  border: 1px solid $grey-lighter;

  &:focus {
    left: 10px;
    top: 10px;
    color: $link-hover-color;
  }
}

blockquote {
  border-left: 4px solid $grey-lighter;
  margin: 0;
  padding-left: 1em;
  color: $black-lighter;
}

iframe, img, video {
  max-width: 100%;
}

table {
  border-collapse: collapse;
  border-spacing: 0;
  font-size: $font-size-small;
  width: 100%;
  margin: 0 0 20px;
}

caption, td, th {
  padding: 8px;
  vertical-align: middle;
  border: 1px solid $grey-lighter;
}

caption {
  border: none;
}

th {
  border-bottom-width: 3px;
}

tbody tr:nth-of-type(odd) {
  background: $whitesmoke-light;
}

figure figcaption {
  text-align: center;
  font-size: $font-size-smaller;
  color: $black-lighter;
}

p, figure {
  img {
    display: block;
    margin: 0 auto;
    max-width: 100%;
  }
}

@media screen and (max-width: 1023px) {
  html {
    text-align: left;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  /* Reduced motion means less movement, not less feedback: motion is removed
     outright, while colour/opacity transitions that confirm state are kept. */
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-property: color, background-color, border-color, opacity !important;
    transition-duration: 150ms !important;
  }
}
