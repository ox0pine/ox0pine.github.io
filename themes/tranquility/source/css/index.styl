@import '_variables';

$anchor-border = $gainsboro; /* get timeline color config from __config.yml */
timeline_colors = {};

for item in hexo-config('timeline.items') {
  for key in item {
    if (key[0] == 'name') {
      c_name = key[1];
    }

    if (key[0] == 'color') {
      c_value = key[1];
    }
  }

  timeline_colors[c_name] = c_value;
}

.wall-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.wall-bg::before {
  @extend .wall-bg;
  z-index: 2;
  content: ' ';
  background-color: rgba(255, 255, 255, 0.95);
  transition: background-color 150ms ease;
}

@media (hover: hover) and (pointer: fine) {
  .wall-main:hover+.wall-bg::before {
    background-color: rgba(255, 255, 255, 0.8);
  }

  .wall-main:hover+.wall-bg .cursor {
    animation: spark 1s ease infinite;
  }
}

.wall-main {
  position: relative;
  text-align: center;
  z-index: 3;
}

.wall-title {
  font-weight: 600;
  font-size: clamp(2.25rem, 7.2vw, 4.5rem);
  line-height: 1.15;
  overflow-wrap: anywhere;
  animation: flyIn 320ms $ease-out;
}

.wall-subtitle {
  font-size: clamp(1.15rem, 3.4vw, 2.25rem);
  font-weight: bold;
  margin-top: 10px;
}

.wall-description {
  font-size: clamp(0.9rem, 2vw, 1.25rem);
  font-weight: 400;
  margin: 10px 0;
  font-family: $font-family-serif;
  letter-spacing: 0.2em;
}

#heart-curve {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 400px;
  height: 400px;
}

.hello-world {
  position: absolute;
  /* Decorations live in the page margins: the centred title owns the middle
     band, so anything anchored to `50%` ends up behind the headline. */
  top: calc(50% - 240px);
  left: 6vw;
  font-size: 26px;
  display: flex;
  align-items: flex-end;
  width: 220px;
}

.hello-world .cursor {
  height: 2px;
  width: 20px;
  background-color: $text-color;
}

@keyframes spark {
  0% {
    opacity: 0;
  }

  50% {
    opacity: 0;
  }

  51% {
    opacity: 1;
  }

  100% {
    opacity: 1;
  }
}

.normal-eqt {
  position: absolute;
  bottom: 22%;
  left: 6vw;
  opacity: 0.8;
}

.motto {
  font-size: 28px;
  font-weight: bold;
  left: 6vw;
  bottom: 6%;
  position: absolute;
  opacity: 0.3;
}

.poem {
  font-size: 18px;
  position: absolute;
  font-family: $font-family-serif;
  left: 0;
  right: 0;
  text-align: center;
  top: calc(50% + 120px);
  opacity: 0.2;
}

@keyframes flyIn {
  from {
    transform: translateY(-100%);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 首页“关于”区：单栏纯文字。主题原本是「照片 + 短文」两栏，既然不放照片，
   改成窄栏居中的行文排版，靠字号与行距撑起留白，而不是靠一列占位。 */
.about {
  max-width: 720px;
  /* The hero already ends the first screen, so the section only needs a
     breathing gap, not another 200px of blank paper. */
  margin: 64px auto 160px;
  padding: 0 24px;
}

.about-title {
  text-align: center;
  font-size: 40px;
  font-weight: bold;
  margin: 0 0 48px;
}

.about-body {
  font-size: $font-size-base;
  line-height: 2.1;
  letter-spacing: 0.08em;
  font-weight: bold;
  font-family: $font-family-serif;
  /* 中英混排时两端对齐会在西文单词处拉出明显字距，左对齐更稳。 */
  text-align: left;
}

.about-body-p {
  margin: 0 0 1.4em;
  text-indent: 2em;

  &:last-child {
    margin-bottom: 0;
  }
}

.timeline {
  max-width: 1100px;
  margin: 200px auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-head {
  display: flex;
  justify-content: center;
  align-items: center;
}

.timeline-head .title {
  font-size: 40px;
  font-weight: bold;
}

.radio-wrapper {
  display: flex;
  align-items: flex-end;
  margin: 0 10px;
}

.radio {
  position: relative;
  width: 20px;
  margin: 0 10px;
  height: 40px;
}

.radio>label {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  height: 100%;
  margin: auto;
}

.radio>input {
  position: absolute;
  opacity: 0;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  height: 100%;
  margin: auto;
}

.radio-skin {
  height: 100%;
  width: 2px;
  border-radius: 1px;
  background: #ccc;
  transition: background-color 180ms ease;

  &::after {
    transition: background-color 180ms ease, transform 180ms $ease-out;
    display: block;
    height: 20px;
    width: 20px;
    border-radius: 50%;
    background-color: #fafafa;
    border: 2px solid transparent;
    box-sizing: border-box;
    content: '';
    position: absolute;
    left: -9px;
    top: 22px;
    box-shadow: 1px 0 5px rgba(0, 0, 0, 0.2);
  }
}

for v, k in timeline_colors {
  .radio-skin--{v} {
    @extend .radio-skin;

    &::after {
      border-color: convert(k);
    }
  }

  #radio-{v}:checked+.radio-skin--{v} {
    background-color: convert(k);

    &::after {
      background-color: convert(k);
      transform: translateY(-24px);
    }
  }

  .timeline-item-{v}, .timeline-item-{v}--hidden {
    .line-anchor::after {
      background-color: convert(k);
    }

    .line-date-tag {
      background-color: convert(k);
    }
  }

  /*
  .timeline-item-app, .timeline-item-event {
    font-weight: bold;
  }
  */
}

.timeline-body {
  width: 100%;
}

.line-anchor::after {
  content: '';
  position: absolute;
  height: 16px;
  width: 16px;
  border-radius: 50%;
  right: -9px;
  bottom: 0;
  left: -9px;
  top: 0;
  margin: auto;
  border: 2px solid $anchor-border;
}

.line-anchor {
  position: relative;
  height: 20px;
  margin: 10px 4px;
  flex: 0 0 20px;
}

.line-date, .line-title {
  flex: 1;
  display: flex;
  align-items: center;
}

.line-date {
  justify-content: flex-end;
}

.line-title .text-icon {
  margin: 0 8px;
}

.timeline-list {
  position: relative;
}

.timeline-list::before {
  position: absolute;
  content: '';
  top: -20px;
  left: 0;
  right: 0;
  bottom: -20px;
  margin: 0 auto;
  width: 2px;
  background-color: $anchor-border;
  z-index: -1;
}

.timeline-post {
  text-decoration: none;
}

.timeline-item {
  width: 100%;
  display: flex;
  padding: 20px 0;
  justify-content: flex-start;
  align-items: center;
  font-size: 18px;
  overflow: hidden;
  transition: opacity 160ms ease-out, transform 180ms $ease-out, height 200ms $ease-out, padding 200ms $ease-out;
  height: 80px;

  &-first, &-last {
    @extend .timeline-item;
    height: auto;
    padding: 0;
    justify-content: center;
  }

  &:nth-child(even) {
    flex-direction: row-reverse;

    .line-title {
      justify-content: flex-end;
    }

    .line-date {
      justify-content: flex-start;
    }
  }
}

.timeline-item--hidden {
  @extend .timeline-item;
  height: 0;
  padding: 0;
  transform: translateY(-6px);
  opacity: 0;
}

.line-anchor--now, .line-anchor--end {
  height: 40px;
  background: none;
}

.line-anchor--end::after {
  background-color: $anchor-border;
}

.line-anchor--now::after {
  border: 2px solid $anchor-border;
}

.line-date-tag {
  display: inline-block;
  font-size: 14px;
  color: #fff;
  padding: 0 4px;
  border-radius: 3px;
}

@media screen and (max-width: 1023px) {
  .wall {
    height: calc(100vh - 60px);
    height: min(calc(100dvh - 60px), 560px);
    min-height: 420px;
  }

  /* Decorations are grid-positioned for wide screens; on a phone the curve
     sits on top of the subtitle text and the formula becomes unreadable.
     Keep the terminal line above the title and drop the rest to the bottom. */
  .hello-world {
    font-size: 20px;
    left: 20px;
    right: auto;
    top: calc(50% - 200px);
  }

  .normal-eqt,
  .poem {
    display: none;
  }

  #heart-curve {
    top: auto;
    bottom: 10px;
    width: 240px;
    height: 240px;
    margin-top: 0;
  }

  .about {
    margin: 56px auto 120px;
  }

  .about-body-p {
    text-indent: 0;
  }
}

@media screen and (max-width: 415px) {
  .timeline {
    margin: 150px auto;
  }

  .timeline-list {
    .timeline-item {
      flex-direction: column;
      height: auto;
    }

    /* Filtering out a type must still collapse the row; the rule above has
       the same specificity, so repeat the hidden state after it. */
    .timeline-item--hidden {
      height: 0;
      padding: 0;
    }

    .line-date {
      border-radius: 4px;
      border: 2px solid $whitesmoke;
    }

    .line-title {
      background: white;
      border-radius: 4px;
      border: 2px solid $whitesmoke;
      padding: 4px;
    }
  }

  .about {
    margin: 40px auto 96px;
    padding: 0 18px;
  }

  .about-title {
    font-size: 30px;
    margin-bottom: 32px;
  }

  .about-body {
    font-size: 16px;
    line-height: 2;
  }
}