@import '_variables.styl';

.wall-category--plain {
  height: auto;
  width: auto;
  display: block;
  max-width: 900px;
  padding: 0 20px;
  margin: 20px auto;

  .wall-category-title {
    align-items: center;
    justify-content: flex-start;
    font-size: $font-size-title;
    font-weight: bold;

    .title-icon {
      height: ($font-size-title / 1.5);
      width: ($font-size-title / 1.5);
      margin-right: 10px;
    }
  }

  .wall-category-description {
    text-align: left;
  }

  #tags-outer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  /* Tag cloud renders plain links; as inline text they read as one run-on
     sentence, so give each one a chip that shows its own hit area. */
  #tags-outer a {
    display: inline-flex;
    align-items: center;
    padding: 2px 12px;
    border: 1px solid $grey-lighter;
    border-radius: 999px;
    color: $blue-link;
    font-size: 14px;
    line-height: 1.7;
    text-decoration: none;
    transition: background-color 150ms ease, border-color 150ms ease,
      color 150ms ease, transform 140ms $ease-out;

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        background-color: $white-blue;
        border-color: $grey-light;
      }
    }

    &:active {
      transform: scale(0.96);
    }
  }
}

.wall-category-title {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
}

.wall-category-description {
  font-family: $font-family-serif;
  text-align: center;
  margin: 10px 0;
}

.wall-category-title .title-icon {
  height: 50px;
  width: 50px;
  background: url('/images/icon-code.svg') center center / contain no-repeat;
  margin-right: 10px;
}

.wall-category-tags {
  width: 100%;
}

.post-list-empty {
  margin: 80px auto;
  text-align: center;
  color: $black-lighter;
}

.post-card {
  display: block;
  margin: 0;
  padding: 28px 20px;
  border-bottom: 1px solid $grey-lighter;
  transition: background-color 160ms ease;

  &--sticky {
    @extend .post-card;
    background: $white-blue-lightest;
  }

  &:last-child {
    border-bottom: none;
  }

  @media (hover: hover) and (pointer: fine) {
    &:hover {
      background-color: $white-blue-lightest;

      .post-card__title {
        color: $blue-link;
      }
    }
  }
}

.post-list {
  max-width: 900px;
  margin: 20px auto;
}

.post-tags {
  margin-top: 4px;
}

.post__head {
  margin-bottom: 10px;
  display: flex;
  align-items: center;
}

.post-card__title {
  text-decoration: none;
  font-size: 24px;
  font-weight: bold;
  transition: color 150ms ease;
}

.post-title-pined {
  font-size: $font-size-smallest;
  margin: 0 4px;
  padding: 2px 4px;
  border: 1px solid;
  border-radius: 2px;
  color: rgb(75, 5, 5);
}

.post__body {
  display: flex;
  align-items: stretch;
}

.post-cover {
  display: block;
  flex: 0 0 150px;
  min-height: 100px;
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  margin-right: 20px;
  border-radius: 2px;
}

.post-excerpt {
  flex: 1;
  color: #666;
}

.post-excerpt * {
  margin-top: 0;
  margin-bottom: 0;
  line-height: 1.75em;
}

.post__foot {
  display: flex;
  align-items: center;
  margin-top: 10px;
}

.text-link {
  display: inline-flex;
  align-items: center;
}

#tagCanvas {
  display: block;
  width: 100%;
  max-width: 500px;
  margin: 0 auto;
}

.tag-page-title {
  margin: 0 auto;
  max-width: 900px;
  font-size: 40px;
  padding: 80px 20px 20px;
  font-family: $font-family-serif;
}

@media screen and (max-width: 1023px) {
  /* The tag page has no .wall-category wrapper, so these used to skip it;
     keep one padding scale for both page types. */
  .tag-page-title {
    padding: 60px 20px 12px;
  }

  .wall-category .post-list,
  .tag-page-title + .post-list {
    padding: 0 10px;
  }

  .wall-category #tags-outer {
    padding-top: 20px;
  }
}

@media screen and (max-width: 415px) {
  .post__body {
    flex-direction: column;
  }

  .post-cover {
    margin: 10px 0;
  }
}
