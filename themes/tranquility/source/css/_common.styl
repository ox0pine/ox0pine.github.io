@import '_variables';
@import '_normal';
@import '_highlight'; /* layout */

.wall {
  user-select: none;
  -webkit-user-select: none;
  /* The cover owns the whole first screen: the about section is meant to be
     discovered by scrolling, not to peek above the fold. */
  height: calc(100vh - 90px);
  height: calc(100dvh - 90px);
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  max-width: $max-width;
  margin: 0 auto;
  width: 100%;
  overflow: hidden;
}

mjx-container {
  overflow: auto hidden;
}

.math.disply {
  display: block;
  overflow: auto hidden;
}

.wall-main {
  width: 100%;
}

/* text */
.text {
  display: flex;
  align-items: center;
}

.text-icon {
  height: 20px;
  width: 20px;
}

/* active link */
.hover-line {
  position: relative;
}

/* Underline grows with a composited scaleX instead of animating `width`, which
   would relayout the link on every frame. Touch devices get no hover state and
   therefore no underline to get stuck in. */
.hover-line::after {
  transition: transform 180ms $ease-out;
  content: '';
  position: absolute;
  height: 2px;
  width: 100%;
  left: 0;
  bottom: -2px;
  background-color: #000;
  transform: scaleX(0);
  transform-origin: left;
}

@media (hover: hover) and (pointer: fine) {
  .hover-line:hover::after {
    transform: scaleX(1);
  }
}

/* paginator */
.paginator {
  display: flex;
  align-items: center;
}

.page-number.current {
  background-color: $black-dim;
  color: #fff;
}

.page-number {
  text-decoration: none;
  color: $black-dim;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 26px;
  width: 26px;
  overflow: hidden;
  border-radius: 50%;
  border: 1px solid $black-dim;
  margin: 0 8px;
  transition: background-color 180ms ease, color 180ms ease, transform 140ms $ease-out;
}

.page-number:hover {
  background-color: $black-light;
  color: #fff;
}

.page-number:active:not(.current) {
  transform: scale(0.94);
}

/* post */
.post-info {
  font-size: 16px;
  color: $black-extra-lighter;
  margin: 4px 0;
}

.post-date {
  margin: 0 10px;
}

.post-tag {
  text-decoration: none;
  font-size: 16px;
  color: #2c5fa5;
  display: inline-block;
  margin-right: 8px;
  transition: color 150ms ease;
}

.post-tag:hover {
  color: #2472e7;
}

/* matts */
.matts {
  cursor: default;
  display: inline-flex;
  background: url(url_for('/images/matts.svg')) center center / contain no-repeat;
  align-items: center;
  padding: 8px;
  transition: opacity 150ms ease;
}

@media (hover: hover) and (pointer: fine) {
  .matts:hover {
    opacity: 0.8;
  }
}
