{# 字体是 800KB 级的子集，`swap` 会让首屏先用回退字体渲染、下载完再整体替换，
   看起来就是文字「冷不丁换了一张脸」。`optional` 则只在字体及时到位时使用它，
   否则本次加载稳定用回退字体，字体仍在后台下载、下次导航直接命中缓存。 #}
{% if theme.zh_font.style.length %}
  <link rel="preload"
        href="{{ url_for('/font/' ~ theme.zh_font.style[0] ~ '.' ~ theme.zh_font.type) }}"
        as="font"
        type="font/ttf"
        crossorigin/>
{% endif %}
{% for subfont in theme.zh_font.style %}
  <style>
    @font-face {
      font-family: {{ theme.zh_font.fontName }};
      src: url('{{ url_for('/font/' ~ subfont ~ '.' ~ theme.zh_font.type) }}');
      font-weight: {{ subfont }};
      font-style: normal;
      font-display: optional;
    }
  </style>
{% endfor %}
