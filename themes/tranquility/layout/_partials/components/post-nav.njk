<div class="post-nav">
  {% if page.prev %}
    <a class="post-nav-item-left" href="{{ url_for(page.prev.path) }}">
      <span class="post-nav-label">
        <svg class="post-nav-icon"
             viewBox="0 0 24 24"
             width="14"
             height="14"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true">
          <polyline points="15 5 8 12 15 19"/>
        </svg>
        上一篇
      </span>
      <span class="post-nav-title">{{ page.prev.title or "未命名" }}</span>
    </a>
  {% else %}
    <div class="post-nav-item-left"></div>
  {% endif %}
  <div class="vhr"></div>
  {% if page.next %}
    <a class="post-nav-item-right" href="{{ url_for(page.next.path) }}">
      <span class="post-nav-label">
        下一篇
        <svg class="post-nav-icon"
             viewBox="0 0 24 24"
             width="14"
             height="14"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round"
             aria-hidden="true">
          <polyline points="9 5 16 12 9 19"/>
        </svg>
      </span>
      <span class="post-nav-title">{{ page.next.title or "未命名" }}</span>
    </a>
  {% else %}
    <div class="post-nav-item-right"></div>
  {% endif %}
</div>
