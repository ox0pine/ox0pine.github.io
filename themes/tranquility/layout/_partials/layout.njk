<!DOCTYPE html>
{%- set seo = seo_meta(page, config, theme, { home: is_home(), post: is_post(), tag: is_tag(), category: is_category() }) -%}
{%- set navClass = 'head--sticky' if theme.nav and theme.nav.sticky else 'head' -%}
<html lang="{{ page.language or config.language or 'zh-CN' }}">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#ffffff"/>

    <title>{{ seo.title }}</title>
    <link rel="canonical" href="{{ seo.url }}"/>
    {% if config.feed and config.feed.enable %}
      <link rel="alternate"
            type="application/atom+xml"
            title="{{ config.title }}"
            href="{{ url_for('/atom.xml') }}"/>
      <link rel="alternate"
            type="application/rss+xml"
            title="{{ config.title }}"
            href="{{ url_for('/rss2.xml') }}"/>
    {% endif %}
    <meta name="description" content="{{ seo.description }}"/>
    {% if seo.keywords %}<meta name="keywords" content="{{ seo.keywords }}"/>{% endif %}

    <!-- Open Graph -->
    <meta property="og:type" content="{{ seo.type }}"/>
    <meta property="og:site_name" content="{{ config.title }}"/>
    <meta property="og:locale" content="{{ seo.locale }}"/>
    <meta property="og:title" content="{{ seo.title }}"/>
    <meta property="og:description" content="{{ seo.description }}"/>
    <meta property="og:url" content="{{ seo.url }}"/>
    <meta property="og:image" content="{{ seo.image }}"/>
    {% if seo.published %}<meta property="article:published_time" content="{{ seo.published }}"/>{% endif %}
    {% if seo.modified %}<meta property="article:modified_time" content="{{ seo.modified }}"/>{% endif %}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content="{{ seo.title }}"/>
    <meta name="twitter:description" content="{{ seo.description }}"/>
    <meta name="twitter:url" content="{{ seo.url }}"/>
    <meta name="twitter:image" content="{{ seo.image }}"/>

    {% if theme.favicon.apple_touch_icon %}
      <link rel="apple-touch-icon"
            sizes="180x180"
            href="{{ url_for(theme.favicon.apple_touch_icon) }}"/>
    {% endif %}
    {% if theme.favicon.medium %}
      <link rel="icon"
            type="image/png"
            sizes="32x32"
            href="{{ url_for(theme.favicon.medium) }}"/>
    {% endif %}
    {% if theme.favicon.small %}
      <link rel="icon"
            type="image/png"
            sizes="16x16"
            href="{{ url_for(theme.favicon.small) }}"/>
    {% endif %}
    {% if theme.favicon.safari_pinned_tab %}
      <link rel="mask-icon" href="{{ url_for(theme.favicon.safari_pinned_tab) }}"/>
    {% endif %}

    {% if theme.zh_font.enable %}
      {% include('./components/font.njk') %}
    {% endif %}

    <link rel="stylesheet" type="text/css" href="{{ url_for('/css/layout.css') }}"/>

    {% for data in seo.jsonld %}
      <script type="application/ld+json">{{ data | dump }}</script>
    {% endfor %}

    {% block link %}{% endblock link %}
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    {% if theme.search and theme.search.enable %}
      {% include("./components/search-main.njk") %}
    {% endif %}
    <div class="{{ navClass }}">
      <div class="nav">
        <a href="{{ url_for('/') }}" class="nav-logo" aria-label="{{ config.title }} 首页">
          <img alt=""
               width="60"
               height="60"
               loading="eager"
               fetchpriority="high"
               src="{{ url_for(theme.logo) }}"/>
        </a>
        <input id="navBtn" type="checkbox" aria-hidden="true" tabindex="-1"/>
        <div class="nav-right">
          {% if theme.search and theme.search.enable %}
            <div class="search-outer">{% include("./components/search-btn.njk") %}</div>
          {% endif %}
          <div class="nav-menu">
            {% if theme.subpage.enable %}
              {% for nav in theme.subpage.pages %}
                {% set navPath = nav.path or nav.name %}
                <a class="nav-menu-item"
                   href="{{ nav.url or nav_url(navPath) }}"{% if not nav.url and nav_current(page, navPath) %} aria-current="page"{% endif %}>{{ nav.title }}</a>
              {% endfor %}
            {% else %}
              <a class="nav-menu-item"
                 href="{{ nav_url('blog') }}"{% if nav_current(page, 'blog') %} aria-current="page"{% endif %}>博客</a>
            {% endif %}
            {% if theme.cv.enable and theme.cv.showInNav %}
              <a class="nav-menu-item"
                 href="{{ nav_url('cv') }}"{% if nav_current(page, 'cv') %} aria-current="page"{% endif %}>个人简历</a>
            {% endif %}
          </div>
        </div>
        <label class="nav-btn" for="navBtn" aria-label="打开导航菜单"></label>
      </div>
    </div>
    <main class="body" id="main-content">
      {% block body %}{% endblock body %}
    </main>
    {% include "./components/foot.njk" %}

    {% if needs_math(page, theme.mathjax) %}
      <script src="https://unpkg.com/js-polyfills@0.1.43/es6.js"></script>
      <script id="MathJax-script"
              async
              src="https://unpkg.com/mathjax@3.2.2/es5/tex-mml-chtml.js"></script>
    {% endif %}
    {% if theme.search and theme.search.enable %}
      <script src="{{ url_for('js/search.js') }}" defer></script>
      <script>
        window.addEventListener('DOMContentLoaded', function () {
          searchInitialize("{{ url_for(theme.search.path) }}")
        })
      </script>
    {% endif %}
    {% if is_post() %}
      <script src="{{ url_for('js/copy-code.js') }}" defer></script>
    {% endif %}
    {% block script %}{% endblock script %}
  </body>
</html>
