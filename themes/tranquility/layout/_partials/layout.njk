<!DOCTYPE html>
<html lang="zh-cn">
  <head>
    <meta charset="utf8"/>
    {% if theme.google_ad.enable %}
      <meta name="google-adsense-account" content="{{ theme.google_ad.meta_tag }}"/>
    {% endif %}
    <meta name="viewport" content="initial-scale=1.0, width=device-width"/>

    <!-- Canonical URL -->
    <link rel="canonical" href="{{ page.permalink or config.url }}"/>

    <!-- Language and alternate links -->
    {% if page.language %}
      <html lang="{{ page.language }}"/>
    {% else %}
      <html lang="{{ config.language or 'zh-CN' }}"/>
    {% endif %}

    <title>
      {% if is_home() %}
        {{ config.title }}
      {% elif is_post() %}
        {{ page.title }} | {{ config.title }}
      {% elif is_tag() %}
        {{ page.tag }} | {{ config.title }}
      {% else %}
        {{ page.title }} | {{ config.title }}
      {% endif %}
    </title>
    {% if is_post() %}
      <meta name="description" content="{{ page.excerpt or page.description or truncate(strip_html(page.content), {length: 160, omission: '...'}) }}"/>
          <meta name="keywords" content="{{ config.keywords }}"/>
    {% elif is_category() %}
      <meta name="description" content="{{ page.category }}分类下的所有文章 - {{ config.description }}"/>
      <meta name="keywords" content="{{ page.category }}, {{ config.keywords }}"/>
    {% elif is_tag() %}
      <meta name="description" content="{{ page.tag }}标签下的所有文章 - {{ config.description }}"/>
      <meta name="keywords" content="{{ page.tag }}, {{ config.keywords }}"/>
    {% else %}
      <meta name="description" content="{{ config.description }}"/>
      <meta name="keywords" content="{{ config.keywords }}"/>
    {% endif %}
    {% if theme.favicon.apple_touch_icon %}
      <link rel="apple-touch-icon"
            sizes="180x180"
            href="{{ url_for(theme.favicon.apple_touch_icon) }}"/>
    {% endif %}
    {% if theme.favicon.medium %}
      <link rel="icon"
            type="image/png"
            sizes="32x32"
            href="{{ url_for(theme.favicon.medium) }}"/>
    {% endif %}
    {% if theme.favicon.small %}
      <link rel="icon"
            type="image/png"
            sizes="16x16"
            href="{{ url_for(theme.favicon.small) }}"/>
    {% endif %}
    {% if theme.favicon.safari_pinned_tab %}
      <link rel="mask-icon"
            href="{{ url_for(theme.favicon.safari_pinned_tab) }}"
            color="{{ theme.android_chrome_color }}"/>
    {% endif %}
    {% if theme.favicon.android_manifest %}
      <link rel="manifest" href="{{ url_for(theme.favicon.android_manifest) }}"/>
    {% endif %}
    {% if theme.zh_font.enable %}
      {% include('./components/font.njk') %}
    {% endif %}
    <link rel="stylesheet"
          type="text/css"
          href='{{ url_for("/css/layout.css") }}'/>
    {% if theme.baidu_analytics %}
      <script>
        var _hmt = _hmt || [];
        (function () {
          var hm = document.createElement("script");
          hm.src = "https://hm.baidu.com/hm.js?{{theme.baidu_analytics}}";
          var s = document.getElementsByTagName("script")[0];
          s
            .parentNode
            .insertBefore(hm, s);
        })();
      </script>
    {% endif %}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="{{ page.permalink or config.url }}"/>
    <meta property="og:title" content="
      {% if is_home() %}
        {{ config.title }}
      {% elif is_post() %}
        {{ page.title }} | {{ config.title }}
      {% else %}
        {{ page.title }} | {{ config.title }}
      {% endif %}"/>
    <meta property="og:description" content="
      {% if is_post() %}
        {{ page.excerpt or page.description or truncate(strip_html(page.content), {length: 160, omission: '...'}) }}
      {% elif is_category() %}
        {{ page.category }}分类下的所有文章 - {{ config.description }}
      {% elif is_tag() %}
        {{ page.tag }}标签下的所有文章 - {{ config.description }}
      {% else %}
        {{ config.description }}
      {% endif %}"/>
    <meta property="og:image" content="
      {% if page.photos %}
        {{ url_for(page.photos[0]) }}
      {% elif theme.index.photo %}
        {{ url_for(theme.index.photo) }}
      {% else %}
        {{ url_for(theme.logo) }}
      {% endif %}"/>

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image"/>
    <meta property="twitter:url" content="{{ page.permalink or config.url }}"/>
    <meta property="twitter:title" content="
      {% if is_home() %}
        {{ config.title }}
      {% elif is_post() %}
        {{ page.title }} | {{ config.title }}
      {% else %}
        {{ page.title }} | {{ config.title }}
      {% endif %}"/>
    <meta property="twitter:description" content="
      {% if is_post() %}
        {{ page.excerpt or page.description or truncate(strip_html(page.content), {length: 160, omission: '...'}) }}
      {% elif is_category() %}
        {{ page.category }}分类下的所有文章 - {{ config.description }}
      {% elif is_tag() %}
        {{ page.tag }}标签下的所有文章 - {{ config.description }}
      {% else %}
        {{ config.description }}
      {% endif %}"/>
    <meta property="twitter:image" content="
      {% if page.photos %}
        {{ url_for(page.photos[0]) }}
      {% elif theme.index.photo %}
        {{ url_for(theme.index.photo) }}
      {% else %}
        {{ url_for(theme.logo) }}
      {% endif %}"/>

    <!-- Structured Data -->
    {% if is_post() %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": "{{ page.title }}",
      "image": [
        {% if page.photos %}
          {% for photo in page.photos %}
            "{{ url_for(photo) }}"{% if not loop.last %},{% endif %}
          {% endfor %}
        {% else %}
          "{{ url_for(theme.logo) }}"
        {% endif %}
      ],
      "datePublished": "{{ date(page.date, 'YYYY-MM-DD') }}",
      "dateModified": "{{ date(page.updated, 'YYYY-MM-DD') or date(page.date, 'YYYY-MM-DD') }}",
      "author": {
        "@type": "Person",
        "name": "{{ config.author }}"
      },
      "publisher": {
        "@type": "Organization",
        "name": "{{ config.title }}",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ url_for(theme.logo) }}"
        }
      },
      "description": "{{ page.excerpt or page.description or truncate(strip_html(page.content), {length: 160, omission: '...'}) }}"
    }
    </script>
    {% endif %}

    {% block link %}{% endblock link %}
  </head>
  <body>
    {% if theme.algolia and theme.algolia.enable %}
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@docsearch/css@3"/>
    {% elif theme.search and theme.search.enable %}
      {% include("./components/search-main.njk") %}
    {% endif %}
    {% set headClass = 'head--sticky'if theme.nav and theme.nav.sticky else 'head' %}
    <div class={{ headClass }}>
      <div class="nav">
        <a href='{{ url_for("/") }}' class="nav-logo">
          <img alt="logo" height="60px" width="60px" src="{{ url_for(theme.logo) }}"/>
        </a>
        <input id="navBtn" type="checkbox"/>
        <div class="nav-right">
          {% if theme.algolia and theme.algolia.enable %}
            <div class="search-outer" id="algolia-search"></div>
          {% elif theme.search and theme.search.enable %}
            <div class="search-outer">{% include("./components/search-btn.njk") %}</div>
          {% endif %}
          <div class="nav-menu">
            {% if theme.subpage.enable %}
              {% for nav in theme.subpage.pages %}
                {% if nav.url %}
                  <a class="nav-menu-item" href="{{ nav.url }}">{{ nav.title }}</a>
                {% else %}
                  <a class="nav-menu-item" href="{{ url_for(nav.path or nav.name) }}">{{ nav.title }}</a>
                {% endif %}
              {% endfor %}
            {% else %}
              <a class="nav-menu-item" href='{{ url_for("/blog/") }}'>博客</a>
            {% endif %}
            {% if theme.cv.enable and theme.cv.showInNav %}
              <a class="nav-menu-item" href='{{ url_for("/cv/") }}'>个人简历</a>
            {% endif %}
          </div>
        </div>
        <label class="nav-btn" for="navBtn"></label>
      </div>
    </div>
    <div class="body">
      {% block body %}{% endblock body %}
    </div>
    {% include "./components/foot.njk" %}
    {% if theme.mathjax %}
      <script src="https://unpkg.com/js-polyfills@0.1.43/es6.js"></script>
      <script id="MathJax-script"
              async
              src="https://www.unpkg.com/mathjax@3.2.2/es5/tex-mml-chtml.js"></script>
    {% endif %}
    {% if theme.algolia and theme.algolia.enable %}
      <script src="https://cdn.jsdelivr.net/npm/@docsearch/js@3"></script>
      <script type="text/javascript">
        docsearch({
          appId: '{{theme.algolia.appId}}',
          apiKey: '{{theme.algolia.apiKey}}',
          indexName: '{{theme.algolia.indexName}}',
          insights: '{{theme.algolia.insights}}',
          container: 'div#algolia-search',
          debug: '{{theme.algolia.debug}}'
        });
      </script>
    {% elif theme.search and theme.search.enable %}
      <script src="{{url_for('js/search.js')}}"></script>
      <script>
        searchInitialize("{{url_for(theme.search.path)}}")
      </script>
    {% endif %}
    <script src="{{url_for('js/copy-code.js')}}"></script>
    {% block script %}{% endblock script %}
  </body>
</html>
