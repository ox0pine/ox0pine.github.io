{% macro timeline(data) %}
  <script type="text/javascript">
    (function () {
      const listEl = document.querySelector('#timeline-list')
      if (!listEl) return

      const { types = [], posts = [] } = {{ data | dump }} || {}
      const radios = types.map(type => document.querySelector('#radio-' + type))
      const rows = posts.map(post => ({ type: post.type, el: createRow(post) }))

      listEl.append(...rows.map(row => row.el))

      types.forEach((type, i) => {
        const radio = radios[i]
        if (!radio) return
        radio.addEventListener('change', e => updateList(type, e.target.checked))
        updateList(type, radio.checked)
      })

      function updateList(type, visible) {
        rows.forEach(row => {
          if (row.type !== type) return
          row.el.classList.toggle('timeline-item--hidden', !visible)
        })
      }

      function createRow(post) {
        const row = document.createElement('div')
        row.className = 'timeline-item timeline-item-' + post.type + ' timeline-item--hidden'

        const date = document.createElement('div')
        date.className = 'line-date'
        const dateTag = document.createElement('div')
        dateTag.className = 'line-date-tag'
        dateTag.textContent = post.date
        date.append(dateTag)

        const anchor = document.createElement('div')
        anchor.className = 'line-anchor'

        const title = document.createElement('div')
        title.className = 'line-title'
        const icon = document.createElement('img')
        icon.className = 'text-icon'
        icon.src = post.icon
        icon.alt = ''
        icon.width = 20
        icon.height = 20
        icon.loading = 'lazy'
        const link = document.createElement('a')
        link.className = 'timeline-post'
        link.href = post.path
        link.textContent = post.title
        title.append(icon, link)

        row.append(date, anchor, title)
        return row
      }
    })()
  </script>
{% endmacro %}
