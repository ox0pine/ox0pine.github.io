{% for p in posts.toArray() %}
  {% set sticky = p.sticky %}
  <article class="post-card{{ '--sticky' if sticky else '' }}">
    <div class="post__head">
      <a href="{{ url_for(p.path) }}" class="post-card__title hover-line">{{ p.title or "未命名" }}</a>
      {% if p.sticky %}<span class="post-title-pined">置顶</span>{% endif %}
    </div>
    <div class="post__body">
      {% if p.cover %}
        <a href="{{ url_for(p.path) }}"
           class="post-cover"
           aria-hidden="true"
           style="background-image: url({{ url_for(p.cover) }})"></a>
      {% endif %}
      <div class="post-excerpt">
        {% if p.abstract or p.excerpt %}
          {{ p.abstract or p.excerpt }}
        {% else %}
          <p>{{ excerpt_text(p, 120) }}</p>
        {% endif %}
      </div>
    </div>
    {% if p.tags and p.tags.length %}
      <div class="post__foot">
        <div class="post-tags">{{ partial("_partials/macros/tags.njk", {tags: p.tags}) }}</div>
      </div>
    {% endif %}
  </article>
{% endfor %}
