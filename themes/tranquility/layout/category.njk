{% extends "_partials/layout.njk" %}
{% block link %}
  <link rel="stylesheet" type="text/css" href="{{ url_for("/css/category.css") }}"/>
{% endblock link %}
{% block body %}
  {% set fancy = theme.tagcloud.fancy %}
  <div class="wall wall-category{{ '--plain' if not fancy else '' }}">
    <div class="wall-main">
      <div class="wall-category-title">
        {% if page.icon %}
          <div class="title-icon"
               style="background-image: url({{ url_for(page.icon) }})"></div>
        {% endif %}
        {{ page.title or page.name }}
      </div>
      {% if page.description %}<div class="wall-category-description">{{ page.description }}</div>{% endif %}
      {% if page.tags %}
        <div class="wall-category-tags">
          <div id="tags-outer">{{ trqlt_tagcloud(page.tags, theme.tagcloud) }}</div>
        </div>
      {% endif %}
    </div>
  </div>
  <div class="post-list">
    {% if not page.posts or not page.posts.length %}
      <p class="post-list-empty">该分类下暂无文章。</p>
    {% else %}
      {{ partial("_partials/macros/post-list.njk", {posts: page.posts}) }}
    {% endif %}
    {% include "_partials/macros/paginator.njk" %}
  </div>
{% endblock body %}
{% block script %}
  {% if fancy and page.tags %}
    <script type="text/javascript" src="{{ url_for('/js/tagcanvas.min.js') }}" defer></script>
    <script type="text/javascript">
      window.addEventListener('load', function () {
        try {
          TagCanvas.Start('tagCanvas', '', {
            outlineThickness: 1,
            maxSpeed: 0.03,
            textColour: null,
            outlineColour: "#aaa",
            weight: true,
            padding: 4,
            fadIn: 200,
            wheelZoom: false,
            initial: [0.1, -0.03]
          });
        } catch (e) {
          document.getElementById('tags-outer').style.display = 'none';
        }
      })
    </script>
  {% endif %}
{% endblock script %}
