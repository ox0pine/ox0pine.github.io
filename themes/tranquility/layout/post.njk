{% extends "_partials/layout.njk" %}
{% block link %}
  <link rel="stylesheet" type="text/css" href="{{ url_for('/css/post.css') }}"/>
{% endblock link %}

{% block script %}
  {% if page.toc %}<script src="{{ url_for('js/toc.js') }}" defer></script>{% endif %}
{% endblock script %}

{% block body %}
  <article class="post-content">
    <div class="post-inner{{ ' post-inner--toc' if page.toc else '' }}">
      <div class="post-content__head">
        <h1 class="post-title">{{ page.title or "未命名" }}</h1>
        <div class="post-info">
          {{ partial("_partials/macros/tags.njk", {tags: page.tags}) }}
          <time class="post-date" datetime="{{ page.date.format('YYYY-MM-DD') }}">{{ date(page.date) }}</time>
          {% if page.categories and page.categories.length %}
            <span class="post-category">分类:
              {% for category in page.categories.toArray() %}
                <a href="{{ url_for(category.path) }}">{{ category.name }}</a>{% if not loop.last %}, {% endif %}
              {% endfor %}
            </span>
          {% endif %}
        </div>
        {% if page.excerpt or page.description %}
          <div class="post-excerpt">{{ page.excerpt or page.description }}</div>
        {% endif %}
      </div>
      {% if page.toc %}
        <aside class="toc-outer" aria-label="文章目录">
          <div class="toc-title">目录</div>
          {{ toc(page.content, {list_number: false, max_depth: 4, class: 'post-toc'}) }}
          <a href="#main-content" class="toc-top">回到顶部</a>
        </aside>
      {% endif %}
      <div class="post-content__body">
        {% if page.photos and page.photos.length %}
          <div class="post-gallery">
            {% for photo in page.photos %}
              <img alt="文章配图" loading="lazy" decoding="async" src="{{ url_for(photo) }}"/>
            {% endfor %}
          </div>
        {% endif %}
        {{ page.content }}
      </div>
    </div>
  </article>
  <div class="post__foot">
    {% include "_partials/components/post-nav.njk" %}
  </div>
{% endblock body %}
