{% extends "_partials/layout.njk" %}
{% block link %}
  <link rel="stylesheet" type="text/css" href="{{ url_for("/css/index.css") }}"/>
{% endblock link %}
{% block body %}
  <div class="wall wall-index">
    <div class="wall-main" id="wall-main">
      <h1 class="wall-title">{{ config.title | upper }}</h1>
      <p class="wall-subtitle">{{ config.subtitle }}</p>
      {% if theme.slogan %}<p class="wall-description">{{ theme.slogan }}</p>{% endif %}
    </div>
    <div class="wall-bg">
      <div class="wall-bg-index">
        <div class="hello-world" aria-hidden="true">
          <div>&gt; Hello world</div>
          <div class="cursor"></div>
        </div>
        <div class="normal-eqt" aria-hidden="true">
          <div class="normal-eqt__line">Attention(<i>Q</i>, <i>K</i>, <i>V</i>)</div>
          <div class="normal-eqt__line">
            = softmax(<i>QK</i><sup>T</sup> / &radic;<i>d</i><sub>k</sub>) <i>V</i>
          </div>
        </div>
        <canvas width="400" height="400" id="heart-curve" aria-hidden="true"></canvas>
        {% if theme.index.motto %}<div class="motto" aria-hidden="true">{{ theme.index.motto }}</div>{% endif %}
        {% if theme.index.poem %}
          <div class="poem" aria-hidden="true">
            {% for line in theme.index.poem %}
              {{ line }}
              <br/>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
  <section class="about">
    <h2 class="about-title">
      {% for word in theme.index.about.title %}
        <span class="matts">{{ word }}</span>
      {% endfor %}
    </h2>
    <div class="about-body">
      {% for paragraph in theme.index.about.text %}
        <p class="about-body-p">{{ paragraph }}</p>
      {% endfor %}
    </div>
  </section>
  {% if theme.timeline and theme.timeline.enable %}
    <section class="timeline">
      <div class="timeline-head">
        <h2 class="title">时间线</h2>
        <div class="radio-wrapper">
          {% for item in theme.timeline.items %}
            <div class="radio">
              <input id="radio-{{ item.name }}"
                     type="checkbox"
                     aria-label="{{ item.name }}"
                     {% if item.checked %}checked{% endif %}/>
              <label class="radio-skin--{{ item.name }}" for="radio-{{ item.name }}"></label>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="timeline-body">
        <div class="timeline-item-first">
          <div class="line-anchor line-anchor--now"></div>
        </div>
        <div class="timeline-list" id="timeline-list"></div>
        <div class="timeline-item-last">
          <div class="line-anchor line-anchor--end"></div>
        </div>
      </div>
    </section>
  {% endif %}
{% endblock body %}
{% block script %}
  <script src="{{ url_for('js/heart-curve.js') }}" defer></script>
  {% if theme.timeline and theme.timeline.enable %}
    {% from "_partials/scripts/Timeline.njk" import timeline %}
    {{ timeline(site.timelineData) }}
  {% endif %}
{% endblock script %}
