{% extends "_partials/layout.njk" %}
{% block link %}
  <link rel="stylesheet" type="text/css" href="{{ url_for("/css/index.css") }}"/>
{% endblock link %}
{% block body %}
  <div class="wall wall-index">
    <div class="wall-main" id="wall-main">
      <h1 class="wall-title">{{ config.title | upper }}</h1>
      <p class="wall-subtitle">{{ config.subtitle }}</p>
      {% if theme.slogan %}<p class="wall-description">{{ theme.slogan }}</p>{% endif %}
    </div>
    <div class="wall-bg">
      <div class="wall-bg-index">
        <canvas id="leaf-field" aria-hidden="true"></canvas>
        {% if theme.index.poem %}
          <div class="poem" aria-hidden="true">
            {% for line in theme.index.poem %}<span class="poem__line">{{ line }}</span>{% endfor %}
          </div>
        {% endif %}
        {% if theme.index.motto %}<div class="motto" aria-hidden="true">{{ theme.index.motto }}</div>{% endif %}
      </div>
    </div>
  </div>
  <section class="about">
    <h2 class="about-title">
      {% for word in theme.index.about.title %}
        <span class="matts">{{ word }}</span>
      {% endfor %}
    </h2>
    <div class="about-body">
      {% for paragraph in theme.index.about.text %}
        <p class="about-body-p">{{ paragraph }}</p>
      {% endfor %}
    </div>
  </section>
  {% if theme.timeline and theme.timeline.enable %}
    {% from "_partials/macros/timeline.njk" import timelineSection with context %}
    {{ timelineSection(site.timelineHome, site.timelineHasMore and url_for('timeline/'), site.timelineTotal) }}
  {% endif %}

{% endblock body %}
{% block script %}
  <script src="{{ url_for('js/leaves.js') }}" defer></script>
  {% if theme.timeline and theme.timeline.enable %}
    {% from "_partials/scripts/Timeline.njk" import timeline %}
    {{ timeline(site.timelineHome) }}
  {% endif %}
{% endblock script %}
